# NearNow root Docker Compose configuration
# Copy to .env and replace secrets before running Docker Compose.
DB_PASSWORD=change_this_local_password
JWT_SECRET=replace_with_a_random_32_plus_character_secret
INTERNAL_API_KEY=replace_with_a_random_internal_ai_key

# AI provider (optional for features that call Gemini; /health still works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Existing NearNow mail configuration (optional for local demo)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Payments stay mocked for zero-cost local development
PAYMENT_MODE=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Browser origins allowed by Spring Boot
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:8080

# Portal server-side calls the backend container; browser calls the Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=http://backend:8080/api

SPRING_BOOT_TIMEOUT_SECONDS=10
