# Must exactly match the Spring Boot INTERNAL_API_KEY value. Use a long random secret.
INTERNAL_API_KEY=replace-with-a-long-random-shared-secret

# Docker default; use http://localhost:8080 only when the AI service runs outside Compose.
SPRING_BOOT_BASE_URL=http://backend:8080
SPRING_BOOT_TIMEOUT_SECONDS=10

# Optional free-provider/local-runtime configuration. Feature owners decide which to use.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
