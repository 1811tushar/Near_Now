# Build output — regenerated by Maven every time, never source-of-truth
target/
*.class

# IDE-specific files — everyone's IDE setup differs, shouldn't be shared
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Local environment overrides — anyone's machine-specific secrets/config
# that should NEVER be committed, even by accident
.env
application-local.properties
*.local.properties

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
